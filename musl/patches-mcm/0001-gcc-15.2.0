diff -rNU3 musl-cross-make.old/patches/gcc-15.2.0/0001-ssp_nonshared.diff musl-cross-make/patches/gcc-15.2.0/0001-ssp_nonshared.diff
--- musl-cross-make.old/patches/gcc-15.2.0/0001-ssp_nonshared.diff	1970-01-01 00:00:00.000000000 +0000
